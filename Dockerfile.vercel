FROM node:22-bookworm-slim AS web-build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --include=dev --no-audit --no-fund

# Build from an explicit source list. No local environment files enter a layer.
COPY index.html tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY vite.config.ts tailwind.config.js postcss.config.js ./
COPY src/ ./src/
COPY public/ ./public/
COPY api/ ./api/
COPY server/ ./server/
COPY scripts/export_regions.ts ./scripts/export_regions.ts
RUN npm run build \
    && npm prune --omit=dev --no-audit --no-fund

FROM python:3.12-slim-bookworm AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NODE_ENV=production \
    NODE_EXECUTABLE=/usr/local/bin/node \
    PORT=8000
WORKDIR /app

# Both stages use Debian bookworm; only the Node executable is needed at runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=web-build /usr/local/bin/node /usr/local/bin/node
COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt \
    && groupadd --gid 10001 ongil \
    && useradd --uid 10001 --gid ongil --create-home ongil

COPY --from=web-build /app/package.json /app/package-lock.json ./
COPY --from=web-build /app/node_modules/ ./node_modules/
COPY --from=web-build /app/dist/ ./dist/
COPY --from=web-build /app/server/ ./server/
COPY --from=web-build /app/src/data/ ./src/data/
COPY --from=web-build /app/src/types/ ./src/types/
COPY backend/ ./backend/
# Use the catalogue generated from the same TypeScript source as the frontend.
COPY --from=web-build /app/backend/data/tourism-regions.json ./backend/data/tourism-regions.json

USER ongil
RUN node --version \
    && node --import tsx --input-type=module -e "await import('./server/briefing/service.ts')" \
    && python -c "from backend.app import app; from backend.container import container_port; container_port()"

EXPOSE 8000
# Exec form lets Uvicorn receive SIGTERM and close the existing Node worker.
CMD ["python", "-m", "backend.container"]
