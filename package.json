{
  "name": "ongil-tourism-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync:regions": "tsx scripts/sync_region_catalogue.ts && npm run export:regions",
    "test": "tsx scripts/export_regions.ts --check && tsc -p tsconfig.server-test.json && node --test tests/*.test.mjs",
    "test:briefing": "tsx --test server/briefing/briefing.test.ts",
    "check:briefing": "tsx scripts/check_monthly_briefing.ts",
    "dev": "node scripts/dev.mjs",
    "build": "npm run export:regions && tsc -b && vite build",
    "preview": "vite preview",
    "dev:web": "vite",
    "export:regions": "tsx scripts/export_regions.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slider": "^1.2.3",
    "@supabase/supabase-js": "^2.116.0",
    "@svg-maps/south-korea": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.2",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.23.13",
    "zod": "^4.6.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "supabase": "^2.117.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
