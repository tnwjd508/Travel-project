# 공공데이터포털에서 발급된 일반 인증키(Decoding)를 입력하세요.
# VITE_ 접두사를 붙이면 브라우저 번들에 노출되므로 사용하지 않습니다.
TOUR_API_SERVICE_KEY=your_tour_api_service_key_here

# 마지막으로 확인한 데이터 기준월. 최신월 자동 탐지가 아니며 갱신 시 완월 여부를 확인합니다.
TOUR_API_INDEX_BASE_YM=202608
TOUR_API_VISITOR_BASE_YM=202607

# 통합 컨테이너의 실행 포트. Vercel 프로젝트에도 PORT=8000을 설정합니다.
PORT=8000

# 로컬 Vite 또는 별도 서버를 쓰는 기존 프록시 구성에만 사용합니다.
# 현재 Vercel 통합 컨테이너에는 FASTAPI_BASE_URL을 설정하지 않습니다.
FASTAPI_BASE_URL=http://127.0.0.1:8000
# 기존 분리 배포 전용 토큰. 현재 통합 컨테이너와 로컬 통합 실행에서는 비웁니다.
# 통합 컨테이너는 이 값이 설정돼 있으면 시작을 중단합니다.
FASTAPI_PROXY_TOKEN=

# 개발자가 필요할 때만 활성화하는 화면 진단 정보. 프로덕션 빌드에서는 항상 숨깁니다.
VITE_SHOW_DIAGNOSTICS=false

# VWorld 인증키(서버 전용). 브라우저는 /api/vworld 프록시만 호출하므로 VITE_ 접두사를 붙이지 않습니다.
VWORLD_API_KEY=your_vworld_key_here
# VWorld 인증키 발급 시 등록한 서비스 URL. 프록시가 domain 파라미터로 그대로 전달합니다.
VWORLD_DOMAIN=https://ongil-travel-dashboard.vercel.app

# 월간 브리핑 서버 전용 Gemini 키입니다. VITE_ 접두사를 붙이지 마세요.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 하나의 Supabase 프로젝트를 월간 브리핑과 기관 시나리오가 함께 사용합니다.
SUPABASE_URL=
# 공개 인증키만 /api/account/config를 통해 브라우저에 전달합니다.
SUPABASE_PUBLISHABLE_KEY=
# 서버 전용. 절대 VITE_ 접두사를 붙이지 않습니다.
SUPABASE_SECRET_KEY=
# 기존 JWT 방식 서버 키를 쓰는 경우에만 SECRET_KEY 대신 설정합니다.
SUPABASE_SERVICE_ROLE_KEY=
