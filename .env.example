# 공공데이터포털에서 발급된 일반 인증키(Decoding)를 입력하세요.
# VITE_ 접두사를 붙이면 브라우저 번들에 노출되므로 사용하지 않습니다.
TOUR_API_SERVICE_KEY=your_decoding_service_key_here

# VWorld 2D 지도/WFS 브라우저용 키입니다. 배포 URL을 VWorld에 등록해 사용하세요.
# VITE_ 변수는 브라우저 번들에 포함되므로 도메인 제한을 반드시 유지해야 합니다.
VITE_VWORLD_API_KEY=your_vworld_browser_key_here
# 비워 두면 현재 window.location.origin을 사용합니다.
VITE_VWORLD_DOMAIN=https://ongil-travel-dashboard.vercel.app/
