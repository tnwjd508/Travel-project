# Allow only application/build inputs into the Docker build context.
**
!Dockerfile.vercel
!.dockerignore
!package.json
!package-lock.json
!index.html
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
!vite.config.ts
!tailwind.config.js
!postcss.config.js
!src/
!src/**
!public/
!public/**
!api/
!api/**
!server/
!server/**
!backend/
!backend/**
!scripts/
!scripts/export_regions.ts

# These exclusions win even inside an allowed source directory.
**/.env
**/.env.*
**/env.txt
**/*.env
**/*.env.*
**/*인증키*
**/.npmrc
**/*.pem
**/*.key
**/.git
**/.venv
**/node_modules
**/__pycache__
**/.pytest_cache
**/*.pyc
**/*.tsbuildinfo
**/*.test.ts
backend/tests/
